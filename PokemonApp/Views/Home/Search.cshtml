@{
    ViewBag.Title = "Pokémon List";
}

@Html.AntiForgeryToken()
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.1/css/all.css" integrity="sha384-50oBUHEmvpQ+1lW4y57PTFmhCaXp0ML5d60M1M7uH2+nqUivzIebhndOJK28anvf" crossorigin="anonymous">
<main class="mt-5">
    <h2 class="fw-bold text-center">Pokémon List</h2>

    <div class="w-50 mx-auto mt-4">
        @using (Html.BeginForm("Search", "Home", FormMethod.Get))
        {
            <div class="input-group">
                <input type="text" name="searchString" class="form-control bg-light border-secondary rounded-start-pill border-end-0" placeholder="Search Pokémon..." />
                <button class="btn btn-light border-secondary rounded-end-pill border-start-0" type="submit" id="button-addon2">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        }
    </div>
    <div class="bg-light mt-5 p-3 mx-auto rounded-3">
        <h5 class="fw-bold d-flex align-items-center justify-content-center" id="favorites-count">@TempData["CurrentFavorites"]</h5>
        <div class="pokemon-cards-container mt-4">
            <div class="container">
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="card shadow-sm p-3 h-100" style="border-radius: 20px;">
                                <div class="d-flex">
                                    <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                         style="width: 120px; height: 120px;">
                                        <img src=@item.ImageUrl>
                                    </div>
                                    <div class="flex-grow-1 position-relative">
                                        <button type="button"
                                                class="btn-fav p-0 border-0 bg-transparent position-absolute top-0 end-0"
                                                data-pokemonid="@item.Id"
                                                data-favorited="@item.IsFavorite">
                                            <i id="heart-icon" style="@(item.IsFavorite ? "color: #ff0000;" : "color: #ff0000")" class="@(item.IsFavorite ? "fas" : "far") fa-heart"></i>
                                        </button>
                                        <h5 class="fw-bold mt-3 mb-2">@item.Name</h5>
                                        <div class="mt-2 d-flex-wrap gap-2">
                                            @foreach (var type in item.Types)
                                            {
                                                <span class="badge rounded-pill bg-secondary-subtle text-dark px-3">@type</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="modal fade" id="pokemonLimitModal" data-toggle="modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLongTitle">Lo siento!</h5>
                    </div>
                    <div class="modal-body">
                        No puedes añadir mas de 10 pokemones favoritos a tu cuenta
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
</main>


@section Scripts {
    <script>
        $(document).on("click", ".btn-fav", function () {
            var btn = $(this);
            var icon = btn.find("i");
            var pokemonId = btn.data("pokemonid");
            var isFavorited = (btn.data("favorited") === true || btn.data("favorited") === "True");

            $.ajax({
                url: isFavorited ? "@Url.Action("TryRemoveFavoriteAsync", "Home")" : "@Url.Action("TryAddFavoriteAsync", "Home")",
                type: "POST",
                data: {
                    pokemonId: pokemonId,
                    __RequestVerificationToken: $('input[name ="__RequestVerificationToken"]').val()
                },
                success: function (response)
                {
                    if (!response.success)
                    {
                        var modalPopup = new bootstrap.Modal(document.getElementById("pokemonLimitModal"), {});
                        modalPopup.show();
                        $('#myInput').trigger('focus')
                        return;
                    }
                    icon.toggleClass("fas far");
                    btn.data("favorited", !isFavorited);
                },
            });
        })
    </script>
}

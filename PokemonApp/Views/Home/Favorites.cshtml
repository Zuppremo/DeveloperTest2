@{
    ViewBag.Title = "Favorites";
}

<main class="mt-5">
    <h2 id="favorites-count" class="fw-bold text-center">Favorites (@Model.Count/10)</h2>
    <div class="w-50 mx-auto mt-4">
        <div class="input-group">
            <input type="text" class="form-control bg-light border-secondary rounded-start-pill border-end-0" placeholder="Search Pokémon ...">
            <button class="btn btn-light border-secondary rounded-end-pill border-start-0" type="button" id="button-addon2">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </div>
    <div class="bg-light mt-5 p-3 mx-auto rounded-3">
        <div class="pokemon-cards-container mt-4">
            <div class="container">
                @if (Model.Count <= 0)
                {
                    <div class="text-center py-5">
                        <h1>Aun no tienes pokemon favoritos...</h1>
                        <h2> usa el corazón para agregar los que quieras</h2>
                    </div>
                    return;
                }
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @Html.AntiForgeryToken()
                    @foreach (var item in Model)
                    {
                        <div class="col" id="@item.Id">
                            <div class="card shadow-sm p-3 h-100" style="border-radius: 20px;">
                                <div class="d-flex">
                                    <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                         style="width: 120px; height: 120px;">
                                        <img src=@item.ImageUrl>
                                    </div>
                                    <div class="flex-grow-1 position-relative">
                                        <button type="button"
                                                class="btn-fav p-0 border-0 bg-transparent position-absolute top-0 end-0"
                                                data-pokemonid="@item.Id"
                                                data-favorited="@item.IsFavorite">
                                            <i class="fas fa-heart" style="color: #ff0000;"></i>
                                        </button>
                                        <h5 class="fw-bold mt-3 mb-2">@item.Name</h5>
                                        <div class="mt-2 d-flex-wrap gap-2">
                                            @foreach (var type in item.Types)
                                            {
                                                <span class="badge rounded-pill bg-secondary-subtle text-dark px-3">@type</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $(document).on("click", ".btn-fav", function () {
            var btn = $(this);
            var icon = btn.find("i");
            var pokemonId = btn.data("pokemonid");
            var isFavorited = (btn.data("favorited") === true || btn.data("favorited") === "True");

            $.ajax({
                url: "@Url.Action("TryRemoveFavoriteAsync", "Home")",
                type: "POST",
                data: {
                    pokemonId: pokemonId,
                    __RequestVerificationToken: $('input[name ="__RequestVerificationToken"]').val()
                },
                success: function (response)
                {
                    if (!response.success)
                        return;
                    const element = document.getElementById(pokemonId);
                    element.remove();
                },
            });
        })
    </script>
}


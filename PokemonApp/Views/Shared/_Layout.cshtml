<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pokémon App - @ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/all.min.css" rel="stylesheet" />
</head>
<body>
    @if (User.Identity.IsAuthenticated)
    {
        <nav class="navbar navbar-expand-lg bg-light" data-bs-theme="light">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="#">Pokémon App</a>

                <ul class="navbar-nav">
                    <li class="nav-item mx-5">
                        <a class="nav-link" href="@Url.Content("~/Home/Index")">Pokémon List</a>
                    </li>
                    <li class="nav-item mx-5">
                        <a class="nav-link" href="@Url.Content("~/Home/Favorites")">Favorites</a>
                    </li>
                    <li class="nav-item mx-5">
                        <a class="nav-link" href="@Url.Content("~/Account/Index")">Users</a>
                    </li>                    
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @User.Identity.Name
                            <i class="fas fa-user ms-2"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="@Url.Content("~/Account/SignOut")"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
    }

        <div class="container body-content">
            @RenderBody()
        </div>
        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")
        @RenderSection("scripts", required: false)
    </body>
</html>
